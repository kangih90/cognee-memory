# Copy to .env and fill in. Used by sync_obsidian.py, llm_check.py and install_launchd.py
# on this machine (the Docker deploy uses deploy/.env and deploy/cognee.env instead).

# LLM (OpenRouter through LiteLLM)
LLM_PROVIDER="custom"
LLM_MODEL="openrouter/openai/gpt-oss-120b"
LLM_ENDPOINT="https://openrouter.ai/api/v1"
LLM_API_KEY=""

# Embeddings: local, multilingual (Korean), no API key
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
EMBEDDING_DIMENSIONS=384

# Storage shared by the sync script and cognee-mcp (stdio). Absolute paths.
DATA_ROOT_DIRECTORY="/path/to/this/folder/.cognee_data"
SYSTEM_ROOT_DIRECTORY="/path/to/this/folder/.cognee_system"

# Obsidian vault sync
OBSIDIAN_VAULT_PATH="/path/to/your/vault"
OBSIDIAN_SYNC_LOCK_PATH="/path/to/this/folder/.obsidian_sync.lock"

# macOS LaunchAgent (install_launchd.py)
OBSIDIAN_SYNC_INTERVAL=1800
OBSIDIAN_SYNC_PYTHON="/path/to/venv/bin/python"
OBSIDIAN_SYNC_LOG_DIR="/path/to/this/folder/logs"
