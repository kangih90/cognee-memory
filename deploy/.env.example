# Copy to deploy/.env and fill in. Read by docker compose (not by cognee).

# Public domain whose DNS A record points at this server.
MCP_DOMAIN=mcp.example.com
# Clients send "Authorization: Bearer <MCP_TOKEN>". Generate: openssl rand -hex 32
MCP_TOKEN=

# Database passwords. Generate: openssl rand -hex 16
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

# Vault folder inside the "gdrive" rclone remote. Empty = the remote's root folder
# (set root_folder_id in rclone.conf to point the root at the vault backup).
DRIVE_VAULT_PATH=

# Seconds between runs.
DRIVE_SYNC_INTERVAL=600
OBSIDIAN_SYNC_INTERVAL=1800
